# ===== CÁCH THÊM API KEY QWEN =====
#
# Bước 1: Copy file này, đổi tên bản copy thành ".env" (để cùng thư mục với main.py).
# Bước 2: Dán key OpenRouter vào sau dấu "=" ở dòng cuối, viết liền, không có dấu cách.
#         Ví dụ:  OPENROUTER_API_KEY=sk-or-v1-abc123...
#         Lấy key tại: https://openrouter.ai/keys
# Bước 3: Chạy chương trình:
#         - Bằng Python: python main.py ...            (tự đọc file .env)
#         - Bằng Docker: docker run --env-file .env ... (phải có --env-file .env)
#

OPENROUTER_API_KEY=
